    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#17171e" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main><%- body %></main>
    <footer>Opsidious</footer>
  </body>
</html>
