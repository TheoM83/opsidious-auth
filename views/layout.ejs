<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <%# Le suffixe est omis quand le titre est deja "Opsidious", sinon l'onglet
        affiche "Opsidious — Opsidious" sur la page d'accueil. %>
