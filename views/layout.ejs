<!doctype html>
<html lang="<%= locale %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title><%= title === 'Opsidious' ? title : title + ' — Opsidious' %></title>
    <%# La page d'accueil est publique et doit être trouvable : le service est
        ouvert à n'importe quelle application, et une porte d'entrée qu'aucun
        moteur ne peut indexer n'est ouverte que pour ceux à qui on l'a dite.
        Tout le reste — connexion, compte — reste hors index. %>
    <% if (typeof noindex === 'undefined' || noindex) { %>
      <meta name="robots" content="noindex" />
    <% } else { %>
      <meta name="description" content="<%= t('home.lede') %>" />
      <%# Une carte de partage, parce que cette page-ci est celle qu'un
          développeur colle dans un fil : sans elle, le lien vers un service
          d'identité arrive sous forme de rectangle vide. Elle est un PNG et
          non l'emblème SVG — aucun des robots qui comptent n'accepte un SVG
          en og:image. %>
      <link rel="canonical" href="<%= canonical %>" />
      <%# Pas de `hreflang` : ce service n'a qu'une URL par page, et la langue
          y est négociée (cookie, puis `ui_locales`, puis `Accept-Language`).
          Déclarer une adresse française qui n'existe pas serait une promesse
          fausse faite à un robot. %>
      <meta property="og:site_name" content="<%= t('common.brand') %>" />
      <meta property="og:title" content="<%= title %>" />
      <meta property="og:description" content="<%= t('home.shareDescription') %>" />
      <meta property="og:type" content="website" />
      <meta property="og:url" content="<%= canonical %>" />
      <meta property="og:locale" content="<%= locale %>" />
      <meta property="og:image" content="<%= shareImage %>" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="<%= t('home.shareImageAlt') %>" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="<%= title %>" />
      <meta name="twitter:description" content="<%= t('home.shareDescription') %>" />
      <meta name="twitter:image" content="<%= shareImage %>" />
      <meta name="twitter:image:alt" content="<%= t('home.shareImageAlt') %>" />
    <% } %>
    <meta name="theme-color" content="#0b0b0e" />
    <link rel="icon" href="/emblem.svg" type="image/svg+xml" />
    <link rel="icon" href="<%= asset('/favicon-32.png') %>" sizes="32x32" />
    <link rel="apple-touch-icon" href="<%= asset('/apple-touch-icon.png') %>" />
    <%# L'adresse porte l'empreinte du contenu : un déploiement qui change la
        feuille change l'adresse, donc un navigateur ne peut plus servir
        l'ancienne. C'est ce qui a rendu le passage du rouge au bleu invisible
        pendant des heures — même URL, cache de sept jours. %>
    <link rel="stylesheet" href="<%= asset('/styles.css') %>" />
  </head>
  <body>
    <a class="skip" href="#main"><%= t('layout.skip') %></a>

    <%# L'emblème mène à l'accueil et rien d'autre : c'est un service
        d'identité, pas un produit à explorer. Une seule destination, donc un
        seul lien — et la langue vit en pied de page, pour que cette règle
        reste vraie. %>
    <header class="topbar">
      <a class="brand" href="/" aria-label="<%= t('common.homeAria') %>">
        <img src="<%= asset('/emblem-mark.svg') %>" alt="" width="22" height="22" />
        <span><%= t('common.brand') %></span>
      </a>
    </header>

    <%# `tabindex="-1"` : sans lui, WebKit fait défiler jusqu'à l'ancre mais
        laisse le focus sur le lien d'évitement, et la tabulation suivante
        repart du haut — le lien ne sert alors à rien pour qui s'en sert. %>
    <main id="main" tabindex="-1"><%- body %></main>

    <footer>
      <%# Le seul lien sortant de ce service, et il est en pied de page : le
          bandeau ne porte qu'une destination, délibérément (voir plus haut).
          Quelqu'un qui vient de voir « Opsidious » dans une barre de redirection
          et qui veut savoir ce que c'est ne devrait pas avoir à deviner
          l'adresse de la plateforme. %>
      <a class="foot-brand" href="https://opsidious.com" target="_blank" rel="noopener"
         aria-label="<%= t('common.platformAria') %>"><%= t('common.brand') %></a>

      <%# Un lien par langue, écrit dans cette langue. `next` renvoie exactement
          là où l'on était : sur /authorize, cela veut dire la demande de
          connexion en cours, paramètres compris. %>
      <nav class="langs" aria-label="Langue · Language">
        <% locales.forEach(function (l) { %>
          <% if (l.code === locale) { %>
            <span class="lang lang--current" lang="<%= l.code %>" aria-current="page"><%= l.endonym %></span>
          <% } else { %>
            <a
              class="lang"
              lang="<%= l.code %>"
              hreflang="<%= l.code %>"
              href="/lang/<%= l.code %>?next=<%= encodeURIComponent(currentPath) %>"
              aria-label="<%= t('common.langAria', { lang: l.endonym }) %>"
            ><%= l.endonym %></a>
          <% } %>
        <% }); %>
      </nav>

      <a href="https://github.com/TheoM83/opsidious-auth" rel="noreferrer"><%= t('common.source') %></a>
    </footer>
  </body>
</html>
