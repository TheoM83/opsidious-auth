<%# L'argument de cette page est la ligne elle-même. Elle montre chaque NOM de
    champ — c'est ce qu'exige la transparence — mais pas les valeurs opaques :
    une chaîne hexadécimale aléatoire ne se vérifie contre rien, donc elle
    demande la même confiance que la phrase à côté, et elle donne en plus une
    prise (« cette capture d'écran, c'est cette ligne »). %>

<article class="ledger">
  <header class="ledger-head">
    <p class="eyebrow"><%= t('account.title') %></p>
    <h1><%= t('account.h1') %></h1>
    <p class="lede"><%= t('account.lede') %></p>
  </header>

  <section aria-labelledby="row-title">
    <h2 class="band-h" id="row-title"><%= t('account.rowTitle') %></h2>

    <ol class="fields">
      <% row.forEach(function (f) { %>
        <li class="field<%= f.reveals ? ' field--reveals' : '' %>">
          <div class="field-name"><%= f.field %></div>
          <div class="field-shape"><code><%= f.shape %></code></div>
          <p class="field-kind"><%= f.kind %></p>
          <p class="verdict">
            <% if (f.reveals) { %>
              <span class="verdict-mark" aria-hidden="true"></span><%= f.reveals %>
            <% } else { %>
              <%= t('account.revealsNothing') %>
            <% } %>
          </p>
        </li>
      <% }); %>
    </ol>
  </section>

  <%# Creusé dans la page, jamais posé dessus : ce bloc décrit une absence, et
      une carte en relief dirait exactement le contraire. %>
  <section class="absent" aria-labelledby="absent-title">
    <h2 class="band-h" id="absent-title"><%= t('account.absentTitle') %></h2>
    <ul>
      <% ['email', 'name', 'googleSub', 'salt'].forEach(function (key) { %>
        <li><%= t('account.absent.' + key) %></li>
      <% }); %>
    </ul>

    <p class="cannot">
      <strong><%= t('account.cannotLead') %></strong>
      <%= t('account.cannotBody') %>
    </p>
  </section>

  <section class="acts" aria-labelledby="acts-title">
    <h2 class="band-h" id="acts-title"><%= t('account.actsTitle') %></h2>

    <form method="post" action="/logout" class="act">
      <input type="hidden" name="csrf" value="<%= csrf %>" />
      <div class="act-text">
        <h3><%= t('account.logoutTitle') %></h3>
        <p><%= t('account.logoutBody') %></p>
      </div>
      <button class="btn" type="submit"><%= t('account.logoutButton') %></button>
    </form>

    <form method="post" action="/account/delete" class="act act--danger">
      <input type="hidden" name="csrf" value="<%= csrf %>" />
      <div class="act-text">
        <h3><%= t('account.deleteTitle') %></h3>
        <p><%= t('account.deleteBody') %></p>
        <p class="warn"><%= t('account.deleteWarn') %></p>
      </div>
      <label for="confirm"><%= t('account.deleteConfirmLabel', { word: t('account.deleteWord') }) %></label>
      <input
        id="confirm"
        name="confirm"
        autocapitalize="characters"
        autocomplete="off"
        spellcheck="false"
        required
      />
      <button class="btn btn--danger" type="submit"><%= t('account.deleteButton') %></button>
    </form>
  </section>
</article>
