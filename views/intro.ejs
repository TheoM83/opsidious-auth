<%# Le seul écran de tout le flux, et il ne s'affiche qu'une fois par
    navigateur. §6 disait « aucune page intermédiaire, direct chez Google » ;
    cette décision supposait que les gens sachent ce qu'est Opsidious. Ils ne le
    savent pas, et le seul moment où quelqu'un a envie de le lire est celui où
    il décide de faire confiance.

    Rien ici ne poste, ne lit ni n'exécute : un lien, et une explication. %>

<article class="intro">
  <div class="intro-card">
    <header class="intro-head">
      <img class="intro-mark" src="<%= asset('/mark.svg') %>" alt="" width="36" height="27" />
      <div>
        <h1><%= t('intro.h1') %></h1>
        <p class="intro-sub"><%= t('intro.sub') %></p>
      </div>
    </header>

    <%# Trois parties, et pour chacune ce qu'elle voit puis ce qu'elle ne voit
        pas. La seconde ligne est la seule en rouge : c'est elle qui distingue
        ce service d'une connexion Google ordinaire. %>
    <%# Les deux lignes disent des choses opposées, et sans étiquette la seule
        chose qui les distingue est le rouge contre le gris — invisible pour
        qui ne distingue pas les deux, et pour qui lit à voix haute. Ce qui est
        vu et ce qui ne l'est pas se dit ici en toutes lettres, comme sur
        l'accueil. %>
    <ol class="flow flow--compact">
      <% ['google', 'opsidious', 'application'].forEach(function (key) { %>
        <li>
          <span class="flow-who"><%= t('home.parties.' + key + '.who') %></span>
          <span class="flow-line">
            <span class="flow-label"><%= t('home.sees') %></span>
            <span class="flow-sees"><%= t('home.parties.' + key + '.sees') %></span>
          </span>
          <span class="flow-line flow-line--blind">
            <span class="flow-label"><%= t('home.blind') %></span>
            <span class="flow-blind"><%= t('home.parties.' + key + '.blind') %></span>
          </span>
        </li>
      <% }); %>
    </ol>

    <a class="gbtn" href="<%= vers %>">
      <img class="gbtn__g" src="/google-g.svg" alt="" width="18" height="18" />
      <%= t('intro.button') %>
    </a>

    <p class="intro-note"><%= t('intro.note') %></p>
  </div>

  <p class="intro-foot">
    <a href="/account"><%= t('intro.footAccount') %></a>
    <span aria-hidden="true">·</span>
    <a href="https://github.com/TheoM83/opsidious-auth" rel="noreferrer"><%= t('common.source') %></a>
  </p>
</article>
