# ─── Opsidious Auth ─────────────────────────────────────────────────────────
# Copy to .env for local development. Never commit a filled-in copy.

NODE_ENV=development
PORT=4570

# The public origin this service is reached at. Used for redirect URIs and as
# the `iss` claim. No default: nothing here is hardcoded to any domain.
PUBLIC_URL=http://localhost:4570

# Google OAuth *web application* credentials. The redirect URI registered with
# Google must be exactly {PUBLIC_URL}/callback/google.
# The secret is a real secret - it is not the public client id Defnote used to
# embed in a page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Overrides the `iss` claim if it must differ from PUBLIC_URL. Defaults to
# PUBLIC_URL, which is almost always what you want.
ISSUER=

DB_PATH=
DB_BUSY_TIMEOUT_MS=5000      # how long a write waits on another writer
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_MS=86400000  # daily

SSO_TTL_MS=1209600000        # 14 days, absolute, not sliding
CODE_TTL_MS=60000            # 60 seconds
CODE_RECOVERY_GRACE_MS=5000  # after this, a code stuck in flight is a crash,
                             # not a live race, and its owner may reclaim it
AUTH_REQUEST_TTL_MS=600000   # 10 minutes
ID_TOKEN_TTL_S=120
KEY_ROTATION_MS=2592000000   # 30 days; must be larger than KEY_GRACE_MS
KEY_GRACE_MS=3600000         # 1 hour of continued publication after retirement

SWEEP_INTERVAL_MS=600000     # auth_requests, sessions, expired signing keys
CODE_SWEEP_INTERVAL_MS=30000 # codes only: an abandoned code row names an
                             # application until it is deleted, so it gets a
                             # much shorter cadence than the sweep above

GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120
TOKEN_RATE_LIMIT_WINDOW_MS=60000
TOKEN_RATE_LIMIT_MAX=60

# Protège, dans la base, tout ce qui permettrait d'usurper une identité : la clé
# privée de signature et le pepper. OBLIGATOIRE en production — sans elle le
# service refuse de démarrer.
#
# Elle ne doit apparaître NULLE PART dans la base : c'est tout son intérêt. La
# perdre rend les comptes existants irrécupérables et invalide les jetons émis.
#
#   openssl rand -base64 32
MASTER_KEY=

# ── Language ─────────────────────────────────────────────────────────────
# Served when a request carries no preference at all: no language cookie, no
# `ui_locales` from the application, no Accept-Language. That is a robot or a
# bare curl. The service is open to applications anywhere, so English is the
# useful answer; set `fr` for a French-first deployment.
DEFAULT_LOCALE=en

# ── Open client registration (RFC 7591) ──────────────────────────────────
# On by default, and that is the point rather than an oversight: registration
# can be open because a client that registers receives a subject derived from
# its own client_id, worthless in every other application. Set to `false` for a
# closed instance - the discovery document then omits registration_endpoint and
# scripts/register-client.mjs stays the only way in.
REGISTRATION_ENABLED=true

# Registration is the only unauthenticated endpoint that writes a durable row,
# so its limiter is much tighter than the global one.
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=10

# Bounds on what an unauthenticated caller can write. Small on purpose: nothing
# here should be a place to store data.
MAX_CLIENT_NAME_LENGTH=64
MAX_REDIRECT_URIS=5
MAX_REDIRECT_URI_LENGTH=512
