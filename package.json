{
  "name": "opsidious-auth",
  "version": "1.0.0",
  "description": "Anonymous Google-only identity provider for Opsidious projects",
  "main": "server.js",
  "type": "module",
  "exports": {
    ".": "./server.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node test/run-tests.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "register-client": "node --env-file-if-exists=.env scripts/register-client.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^5.9.6",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  },
  "license": "MIT",
  "overrides": {
    "tar": "^7.5.21",
    "cacache": "^18.0.4",
    "@tootallnate/once": "^2.0.1"
  }
}
